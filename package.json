{
  "name": "sanity-nextjs-starter",
  "description": "Next.js + Sanity: A Powerful Website Starter",
  "keywords": [
    "Sanity",
    "Next.js"
  ],
  "scripts": {
    "build": "pnpm run --parallel --filter './studio' --filter './frontend' build",
    "dev": "pnpm run --parallel --filter './studio' --filter './frontend' dev",
    "format": "prettier --cache --write .",
    "import-sample-data": "cd studio && sanity dataset import sample-data.tar.gz --dataset production --replace",
    "lint": "pnpm --filter frontend lint",
    "type-check": "pnpm -r type-check"
  },
  "prettier": "@sanity/prettier-config",
  "devDependencies": {
    "@sanity/prettier-config": "^3.0.0",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0"
  }
}
